# Database
# Local development (SQLite):
#   DATABASE_URL="file:./dev.db"
#
# Production on Vercel (PostgreSQL) — get a free URL from:
#   - Vercel Postgres (built-in, recommended)
#   - Neon (https://neon.tech) — free tier
#   - Supabase (https://supabase.com) — free tier
#   - Railway (https://railway.app) — free trial
# Example PostgreSQL URL:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (for volunteer registrations and contact form)
EMAIL_TO="youremail@example.com"
EMAIL_USER="your-gmail@gmail.com"
# For Gmail, generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=""

# Stripe - Test Keys (replace with live keys in production)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# M-Pesa Configuration (Kenyan mobile money)
# Get credentials from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="0703456604"  # Your M-Pesa number
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="${NEXT_PUBLIC_APP_URL}/api/donations/mpesa/callback"
MPESA_ENV="sandbox"  # Change to "production" when live

# Admin (change these in production)
ADMIN_PASSWORD=""
ADMIN_EMAIL=""
